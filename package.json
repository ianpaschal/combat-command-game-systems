{
  "name": "@ianpaschal/combat-command-game-systems",
  "version": "2.0.1",
  "description": "Static data used by CombatCommand.net",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./common": "./dist/common/index.js",
    "./battlefront": "./dist/battlefront/index.js",
    "./flamesOfWarV4": "./dist/battlefront/flamesOfWarV4/index.js",
    "./greatWarV4": "./dist/battlefront/greatWarV4/index.js",
    "./teamYankeeV2": "./dist/battlefront/teamYankeeV2/index.js",
    "./boltActionV3": "./dist/warlord/boltActionV3/index.js",
    "./utils": "./dist/common/_internal/index.js"
  },
  "author": "Ian Paschal",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ianpaschal/combat-command-game-systems.git"
  },
  "scripts": {
    "prelint": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "prebuild": "rm -rf ./dist",
    "build": "tsup && npm run build:dts",
    "build:dts": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "vitest run --reporter=verbose --coverage",
    "prepublish": "npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ianpaschal/eslint-config": "^1.0.1",
    "@stylistic/stylelint-config": "^2.0.0",
    "@stylistic/stylelint-plugin": "^3.1.3",
    "@types/lodash": "^4.17.24",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "zod": "^3.25.76"
  }
}
